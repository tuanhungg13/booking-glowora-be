                  "pm.test('Có RspCode', () => pm.expect(b.data).to.have.property('RspCode'));",
                  "pm.test('Có Message', () => pm.expect(b.data).to.have.property('Message'));",
                  "console.log('IPN RspCode:', b.data?.RspCode, '|', b.data?.Message);"
                ]
              }
            }
