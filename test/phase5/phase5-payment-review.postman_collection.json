    {
      "name": "[Payments] VNPAY Flow",
      "item": [
        {
          "name": "12. Tạo VNPAY Payment URL ✅",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const b = pm.response.json();",
            "pm.test('Có paymentUrl', () => pm.expect(b.data).to.have.property('paymentUrl'));",
            "pm.test('Có paymentId', () => pm.expect(b.data).to.have.property('paymentId'));",
            "pm.test('paymentUrl chứa sandbox.vnpayment.vn', () => pm.expect(b.data.paymentUrl).to.include('sandbox.vnpayment.vn'));",
            "pm.test('paymentUrl có vnp_Amount', () => pm.expect(b.data.paymentUrl).to.include('vnp_Amount'));",
            "pm.test('paymentUrl có vnp_SecureHash', () => pm.expect(b.data.paymentUrl).to.include('vnp_SecureHash'));",
            "if (b.data?.paymentId) pm.collectionVariables.set('paymentId', b.data.paymentId);",
            "if (b.data?.paymentUrl) pm.collectionVariables.set('paymentUrl', b.data.paymentUrl);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"appointmentId\": \"{{completedAppointmentId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/payments/vnpay/create", "host": ["{{baseUrl}}"], "path": ["payments","vnpay","create"] }
          }
        },
        {
          "name": "13. Tạo payment 2 lần — idempotent OK (tạo được nhiều PENDING) ✅",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201 — cho phép retry PENDING', () => pm.response.to.have.status(201));",
            "const b = pm.response.json();",
            "pm.test('paymentUrl mới khác paymentUrl cũ', () => {",
            "  pm.expect(b.data.paymentUrl).to.not.equal(pm.collectionVariables.get('paymentUrl'));",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"appointmentId\": \"{{completedAppointmentId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/payments/vnpay/create", "host": ["{{baseUrl}}"], "path": ["payments","vnpay","create"] }
          }
        },
        {
          "name": "14. Tạo payment cho appointment chưa COMPLETED ❌ 400",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 404 hoặc 400', () => pm.expect([400,404]).to.include(pm.response.code));",
            "const b = pm.response.json();",
            "pm.test('Error message', () => pm.expect(b.success).to.be.false);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"appointmentId\": \"00000000-0000-0000-0000-000000000000\"\n}" },
            "url": { "raw": "{{baseUrl}}/payments/vnpay/create", "host": ["{{baseUrl}}"], "path": ["payments","vnpay","create"] }
          }
        },
        {
          "name": "15. [MANUAL] Mở paymentUrl trên browser để test VNPAY",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Đây là bước manual', () => {",
            "  console.log('PaymentUrl:', pm.collectionVariables.get('paymentUrl'));",
            "  console.log('Mở URL trên browser để hoàn tất thanh toán VNPAY sandbox');",
            "  pm.expect(true).to.be.true;",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{paymentUrl}}", "host": ["{{paymentUrl}}"] }
          }
        },
        {
          "name": "16. [Giả lập IPN] VNPAY thông báo thanh toán THÀNH CÔNG ✅",
          "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
            "// Để test thật, cần VNPAY_HASH_SECRET thật + params từ VNPAY",
            "// Request này giả lập cấu trúc IPN (chữ ký sẽ fail nếu không có secret thật)",
            "console.log('Lưu ý: IPN này sẽ trả RspCode 97 (chữ ký sai) nếu không có HASH_SECRET thật');"
          ]}},
          { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 — VNPAY luôn nhận 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('Có RspCode', () => pm.expect(b.data).to.have.property('RspCode'));",
            "pm.test('Có Message', () => pm.expect(b.data).to.have.property('Message'));",
            "console.log('IPN RspCode:', b.data?.RspCode, '|', b.data?.Message);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"vnp_TmnCode\": \"YOUR_TMN_CODE\",\n  \"vnp_Amount\": \"50000000\",\n  \"vnp_BankCode\": \"VCB\",\n  \"vnp_CardType\": \"ATM\",\n  \"vnp_PayDate\": \"20261220093045\",\n  \"vnp_OrderInfo\": \"Thanh toan dich vu\",\n  \"vnp_TransactionNo\": \"14823741\",\n  \"vnp_ResponseCode\": \"00\",\n  \"vnp_TransactionStatus\": \"00\",\n  \"vnp_TxnRef\": \"{{completedAppointmentId}}-REPLACE_WITH_REAL_TXNREF\",\n  \"vnp_SecureHashType\": \"HmacSHA512\",\n  \"vnp_SecureHash\": \"REPLACE_WITH_REAL_HASH\"\n}" },
            "url": { "raw": "{{baseUrl}}/payments/vnpay/ipn", "host": ["{{baseUrl}}"], "path": ["payments","vnpay","ipn"] }
          }
        },
        {
          "name": "17. [Giả lập IPN] Gửi IPN lần 2 — idempotent ✅",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "console.log('IPN lần 2 RspCode:', b.data?.RspCode);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"vnp_TxnRef\": \"{{completedAppointmentId}}-SAME_TXNREF\",\n  \"vnp_Amount\": \"50000000\",\n  \"vnp_ResponseCode\": \"00\",\n  \"vnp_TransactionStatus\": \"00\",\n  \"vnp_SecureHash\": \"SAME_HASH\"\n}" },
            "url": { "raw": "{{baseUrl}}/payments/vnpay/ipn", "host": ["{{baseUrl}}"], "path": ["payments","vnpay","ipn"] }
          }
        },
        {
          "name": "18. [Giả lập IPN] Chữ ký sai → RspCode 97 ✅",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('RspCode là 97 (chữ ký sai)', () => pm.expect(b.data.RspCode).to.equal('97'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"vnp_TxnRef\": \"fake-ref\",\n  \"vnp_Amount\": \"50000000\",\n  \"vnp_SecureHash\": \"INVALID_HASH_XXXX\"\n}" },
            "url": { "raw": "{{baseUrl}}/payments/vnpay/ipn", "host": ["{{baseUrl}}"], "path": ["payments","vnpay","ipn"] }
          }
        },
        {
          "name": "19. Lịch sử thanh toán của Customer ✅",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('data là array', () => pm.expect(b.data).to.be.an('array'));",
            "console.log('My payments count:', b.data?.length);"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/payments/my", "host": ["{{baseUrl}}"], "path": ["payments","my"] }
          }
        },
        {
          "name": "20. Xem thanh toán theo Appointment ✅",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('data là array', () => pm.expect(b.data).to.be.an('array'));",
            "if (b.data?.length > 0) {",
            "  pm.test('Payment có appointmentId khớp', () => {",
            "    pm.expect(b.data[0].appointmentId).to.equal(pm.collectionVariables.get('completedAppointmentId'));",
            "  });",
            "}"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/appointments/{{completedAppointmentId}}/payment", "host": ["{{baseUrl}}"], "path": ["appointments","{{completedAppointmentId}}","payment"] }
          }
        }
      ]
    },
    {
      "name": "[Reviews] Đánh giá dịch vụ",
      "item": [
        {
          "name": "21. Tạo review cho appointment COMPLETED ✅",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const b = pm.response.json();",
            "pm.test('Có id', () => pm.expect(b.data).to.have.property('id'));",
            "pm.test('Rating đúng', () => pm.expect(b.data.rating).to.equal(5));",
            "pm.test('Comment đúng', () => pm.expect(b.data.comment).to.equal('Dịch vụ rất tốt!'));",
            "if (b.data?.id) pm.collectionVariables.set('reviewId', b.data.id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Dịch vụ rất tốt!\"\n}" },
            "url": { "raw": "{{baseUrl}}/appointments/{{completedAppointmentId}}/review", "host": ["{{baseUrl}}"], "path": ["appointments","{{completedAppointmentId}}","review"] }
          }
        },
        {
          "name": "22. Tạo review lần 2 — duplicate ❌ 409",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));",
            "const b = pm.response.json();",
            "pm.test('success là false', () => pm.expect(b.success).to.be.false);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 3,\n  \"comment\": \"Lần 2\"\n}" },
            "url": { "raw": "{{baseUrl}}/appointments/{{completedAppointmentId}}/review", "host": ["{{baseUrl}}"], "path": ["appointments","{{completedAppointmentId}}","review"] }
          }
        },
        {
          "name": "23. Xem review của appointment (PUBLIC — không cần token) ✅",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "if (b.data) {",
            "  pm.test('Rating là 5', () => pm.expect(b.data.rating).to.equal(5));",
            "  pm.test('appointmentId khớp', () => pm.expect(b.data.appointmentId).to.equal(pm.collectionVariables.get('completedAppointmentId')));",
            "}"
          ]}}],
          "request": {
