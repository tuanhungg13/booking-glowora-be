    {
      "name": "[Appointments] Tạo & Xem lịch hẹn",
      "item": [
        {
          "name": "13. Create Appointment (Customer)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const b = pm.response.json();",
            "pm.test('Has appointment id', () => pm.expect(b.data).to.have.property('id'));",
            "pm.test('Status is PENDING or CONFIRMED', () => pm.expect(['PENDING','CONFIRMED']).to.include(b.data.status));",
            "pm.test('Price and duration are snapshots', () => {",
            "  pm.expect(b.data).to.have.property('price');",
            "  pm.expect(b.data).to.have.property('duration');",
            "});",
            "if (b.data?.id) pm.collectionVariables.set('appointmentId', b.data.id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": \"{{storeId}}\",\n  \"serviceId\": \"{{serviceId}}\",\n  \"staffId\": \"{{staffId}}\",\n  \"scheduledAt\": \"{{slotDate}}T{{slotTime}}:00+07:00\",\n  \"notes\": \"Đặt lịch test phase 4\"\n}"
