    {
      "name": "[Slots] Available Slots",
      "item": [
        {
          "name": "10. Get Available Slots (no staffId)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('Has staffSlots array', () => pm.expect(b.data).to.have.property('staffSlots'));",
            "pm.test('Has date field', () => pm.expect(b.data.date).to.equal(pm.collectionVariables.get('slotDate')));",
            "if (b.data?.staffSlots?.length > 0 && b.data.staffSlots[0].availableSlots?.length > 0) {",
            "  pm.collectionVariables.set('slotTime', b.data.staffSlots[0].availableSlots[0]);",
            "  pm.collectionVariables.set('staffId', b.data.staffSlots[0].staffId);",
            "}"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/stores/{{storeId}}/available-slots?date={{slotDate}}&serviceId={{serviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["stores", "{{storeId}}", "available-slots"],
              "query": [
                { "key": "date", "value": "{{slotDate}}" },
                { "key": "serviceId", "value": "{{serviceId}}" }
              ]
            }
          }
        },
        {
          "name": "11. Get Available Slots (with staffId)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 hoặc 400/404', () => pm.expect([200, 400, 404]).to.include(pm.response.code));",
            "if (pm.response.code === 200) {",
            "  const b = pm.response.json();",
            "  pm.test('Has staffSlots', () => pm.expect(b.data).to.have.property('staffSlots'));",
            "}"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/stores/{{storeId}}/available-slots?date={{slotDate}}&serviceId={{serviceId}}&staffId={{staffId}}",
              "host": ["{{baseUrl}}"],
              "path": ["stores", "{{storeId}}", "available-slots"],
              "query": [
                { "key": "date", "value": "{{slotDate}}" },
                { "key": "serviceId", "value": "{{serviceId}}" },
                { "key": "staffId", "value": "{{staffId}}" }
              ]
            }
          }
        },
