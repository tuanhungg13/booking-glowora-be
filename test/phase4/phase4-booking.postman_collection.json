          "name": "25. Cancel Appointment (Customer)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('Status is CANCELLED', () => pm.expect(b.data.status).to.equal('CANCELLED'));",
            "pm.test('cancelledAt is set', () => pm.expect(b.data.cancelledAt).to.not.be.null);"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerAccessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Bận đột xuất\"\n}" },
            "url": { "raw": "{{baseUrl}}/appointments/{{appointmentId}}/cancel", "host": ["{{baseUrl}}"], "path": ["appointments", "{{appointmentId}}", "cancel"] }
          }
        }
      ]
    },
