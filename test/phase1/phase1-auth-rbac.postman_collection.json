          "name": "[Happy] Register new customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Response success = true', () => pm.expect(body.success).to.be.true);",
                  "pm.test('Has user data', () => {",
                  "  pm.expect(body.data).to.have.property('id');",
                  "  pm.expect(body.data).to.have.property('email');",
                  "  pm.expect(body.data).not.to.have.property('password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer_test@glowora.vn\",\n  \"password\": \"Customer@123\",\n  \"fullName\": \"Khách Hàng Test\",\n  \"phone\": \"0901234567\"\n}"
