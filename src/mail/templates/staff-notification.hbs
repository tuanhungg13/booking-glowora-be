<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{subject}}</title>
  <style>
    body { margin: 0; padding: 0; background-color: #f4f4f4; font-family: 'Segoe UI', Arial, sans-serif; }
    .wrapper { max-width: 560px; margin: 40px auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
    .header { background: linear-gradient(135deg, #d4a5c9, #a05e8a); padding: 32px 40px; text-align: center; }
    .header h1 { margin: 0; color: #ffffff; font-size: 24px; letter-spacing: 0.5px; }
    .body { padding: 34px 40px; }
    .greeting { font-size: 16px; color: #444; margin-bottom: 16px; }
    .message { font-size: 15px; color: #555; line-height: 1.6; margin-bottom: 24px; white-space: pre-line; }
    .details { background: #fdf4fb; border: 1px solid #d4a5c9; border-radius: 10px; padding: 18px 22px; margin-bottom: 24px; }
    .row { display: flex; gap: 12px; margin-bottom: 10px; font-size: 14px; color: #444; }
    .row:last-child { margin-bottom: 0; }
    .label { font-weight: 600; color: #a05e8a; min-width: 110px; }
    .btn-wrap { text-align: center; margin-top: 26px; }
    .btn { display: inline-block; padding: 13px 30px; background: linear-gradient(135deg, #d4a5c9, #a05e8a); color: #ffffff; text-decoration: none; border-radius: 28px; font-size: 15px; font-weight: 600; }
    .footer { background: #f9f9f9; padding: 18px 40px; text-align: center; font-size: 12px; color: #aaa; border-top: 1px solid #eee; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <h1>Glowora</h1>
    </div>
    <div class="body">
      <p class="greeting">Xin chào <strong>{{fullName}}</strong>,</p>
      <p class="message">{{body}}</p>

      {{#if hasDetails}}
      <div class="details">
        {{#each details}}
        <div class="row">
          <span class="label">{{label}}</span>
          <span>{{value}}</span>
        </div>
        {{/each}}
      </div>
      {{/if}}

      {{#if hasAction}}
      <div class="btn-wrap">
        <a href="{{actionUrl}}" class="btn">{{actionLabel}}</a>
      </div>
      {{/if}}
    </div>
    <div class="footer">
      © 2026 Glowora · Nền tảng đặt lịch spa &amp; salon
    </div>
  </div>
</body>
</html>
