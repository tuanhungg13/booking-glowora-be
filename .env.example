# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

# ========================
NODE_ENV=
APP_NAME=
APP_PORT=8080
APP_URL=

# ========================
# DATABASE (MySQL)
# ========================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

DATABASE_URL=
# ========================
# REDIS (Cache + BullMQ)
# ========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=

# ========================
# AUTH / SECURITY
# ========================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=


# ========================
# MAIL (SMTP)
# ========================
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# ========================
# FRONTEND
# ========================
# URL chính của FE — dùng để tạo link trong email
FRONTEND_URL=http://localhost:3000
# Danh sách origin được phép CORS, cách nhau bằng dấu phẩy
FRONTEND_CORS_ORIGINS=http://localhost:3000

# ========================
# AI (Google Gemini)
# ========================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ========================
# CLOUDINARY (Image Storage)
# ========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ========================
# BOOKING REMINDERS (Scheduled Job)
# ========================
REMINDER_CRON_EXPR=*/10 * * * *

# Cửa sổ nhắc nhở trước 1 ngày: tìm booking có scheduledAt trong khoảng
REMINDER_1DAY_WINDOW_FROM_H=23
REMINDER_1DAY_WINDOW_TO_H=25

# Cửa sổ nhắc nhở trước 1 giờ: tìm booking có scheduledAt trong khoảng
REMINDER_1HOUR_WINDOW_FROM_M=30
REMINDER_1HOUR_WINDOW_TO_M=90

# ========================
# WEB PUSH (VAPID)
# ========================

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ========================
# TELEGRAM BOT
# ========================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=

WEB_CONCURRENCY=

DB_CONNECTION_BUDGET=
MYSQL_MAX_CONNECTIONS=