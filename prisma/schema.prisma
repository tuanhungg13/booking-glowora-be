// ============================================================
// GLOWORA BOOKING PLATFORM — COMPLETE SCHEMA (All Phases)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
  SUSPENDED
}

enum StoreStatus {
  PENDING
  ACTIVE
  INACTIVE
  BANNED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DEPOSIT_PENDING // Đã xác nhận, chờ khách thanh toán cọc
  DEPOSIT_PAID    // Đã cọc, chờ thực hiện dịch vụ
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  SEPAY
  CASH
}

enum PaymentType {
  DEPOSIT
  FULL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_REJECTED
  BOOKING_COMPLETED
  BOOKING_CANCELLED
  BOOKING_DEPOSIT_REQUIRED
  BOOKING_DEPOSIT_PAID
  BOOKING_DEPOSIT_EXPIRED
  STORE_APPROVED
  STORE_REJECTED
  STORE_LOCKED
  STAFF_INVITED
  PAYMENT_SUCCESS
  BOOKING_REMINDER_1DAY
  BOOKING_REMINDER_1HOUR
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum StaffInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum LogStatus {
  SUCCESS
  ERROR
}

enum LogType {
  SYSTEM_ERROR
  AUTH_REGISTER
  AUTH_LOGIN
  AUTH_LOGOUT
  STORE_CREATED
  STORE_APPROVED
  STORE_REJECTED
  STORE_BANNED
  STORE_UNLOCKED
  USER_BANNED
  USER_UNBANNED
  PAYMENT_COMPLETED
  PAYMENT_FAILED
  REVIEW_HIDDEN
  REVIEW_SHOWN
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_REJECTED
  BOOKING_COMPLETED
  BOOKING_CANCELLED
  BOOKING_DEPOSIT_PAID
  BOOKING_DEPOSIT_EXPIRED
  COUPON_CREATED
  COUPON_UPDATED
  COUPON_DELETED
  SERVICE_CREATED
  SERVICE_UPDATED
  SERVICE_DELETED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum ConversationMode {
  BOT
  HUMAN
}

enum SenderType {
  CUSTOMER
  STAFF
  BOT
}

// =============================================================================
// RBAC: Role, Permission, RolePermission, UserRole
// =============================================================================

model Role {
  id          String  @id @default(uuid()) @db.Char(36)
  name        String  @db.VarChar(100)
  code        String  @db.VarChar(50)
  description String?
  isSystem    Boolean @default(false) @map("is_system")
  storeId     String? @map("store_id") @db.Char(36)

  store       Store?           @relation("StoreRoles", fields: [storeId], references: [id])
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([code, storeId])
  @@index([storeId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Char(36)
  code        String  @unique @db.VarChar(100)
  name        String  @db.VarChar(150)
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Char(36)
  permissionId String @map("permission_id") @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  roleId    String   @map("role_id") @db.Char(36)
  storeId   String?  @map("store_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role  Role   @relation(fields: [roleId], references: [id])
  store Store? @relation("UserStoreRoles", fields: [storeId], references: [id])

  // Note: MySQL treats NULL != NULL so unique on nullable storeId is enforced in code for system roles
  @@unique([userId, roleId, storeId])
  @@index([userId])
  @@index([storeId])
  @@map("user_roles")
}

// =============================================================================
// MODEL: User
// =============================================================================

model User {
  id           String     @id @default(uuid()) @db.Char(36)
  fullName     String     @map("full_name") @db.VarChar(100)
  email        String     @unique @db.VarChar(150)
  password     String
  phone        String?    @db.VarChar(20)
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(ACTIVE)
  refreshToken String?    @map("refresh_token")
  bannedAt     DateTime?  @map("banned_at")
  banReason    String?    @map("ban_reason") @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  userRoles      UserRole[]
  ownedStores    Store[]        @relation("StoreOwner")
  approvedStores Store[]        @relation("StoreApprover")
  staffProfiles  Staff[]
  bookings       Booking[]      @relation("CustomerBookings")
  payments       Payment[]
  reviews        Review[]       @relation("CustomerReviews")
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  conversations      Conversation[] @relation("CustomerConversations")
  sentMessages       Message[]      @relation("SentMessages")
  systemLogs         SystemLog[]    @relation("ActorLogs")
  createdCoupons     Coupon[]       @relation("CouponCreatedBy")
  couponUsages       CouponUsage[]

  @@map("users")
}

// =============================================================================
// MODEL: Province (Tỉnh / Thành phố)
// =============================================================================

model Province {
  id     Int    @id
  code   String @unique @db.Char(2)
  name   String @db.VarChar(100)
  type   String @db.VarChar(10)

  wards  Ward[]
  stores Store[]

  @@map("provinces")
}

// =============================================================================
// MODEL: Ward (Xã / Phường / Đặc khu)
// =============================================================================

model Ward {
  id         Int      @id
  provinceId Int      @map("province_id")
  name       String   @db.VarChar(100)
  type       String   @db.VarChar(10)

  province   Province @relation(fields: [provinceId], references: [id])
  stores     Store[]

  @@index([provinceId])
  @@map("wards")
}

// =============================================================================
// MODEL: Store
// =============================================================================

model Store {
  id                String      @id @default(uuid()) @db.Char(36)
  slug              String?     @unique @db.VarChar(200)
  ownerId           String      @map("owner_id") @db.Char(36)
  name              String      @db.VarChar(150)
  phone             String      @db.VarChar(20)
  email             String?     @db.VarChar(150)
  website           String?     @db.VarChar(200)
  description       String?     @db.Text
  address           String      @db.VarChar(300)
  wardId            Int?        @map("ward_id")
  provinceId        Int?        @map("province_id")
  latitude          Float?
  longitude         Float?
  logoUrl           String?     @map("logo_url")
  bannerUrl         String?     @map("banner_url")
  status            StoreStatus @default(PENDING)
  approvedById      String?     @map("approved_by_id") @db.Char(36)
  approvedAt        DateTime?   @map("approved_at")
  rejectionReason   String?     @map("rejection_reason") @db.Text
  timezone          String      @default("Asia/Ho_Chi_Minh") @db.VarChar(50)
  slotIntervalMins  Int         @default(30) @map("slot_interval_mins")
  cancelBeforeHours Int         @default(2) @map("cancel_before_hours")
  maxAdvanceDays    Int         @default(30) @map("max_advance_days")
  bookingBufferMins Int         @default(30) @map("booking_buffer_mins")
  autoConfirm       Boolean     @default(false) @map("auto_confirm")
  depositPercent    Int         @default(0) @map("deposit_percent") // 0–100, 0 = không yêu cầu cọc
  avgRating         Decimal     @default(0.00) @map("avg_rating") @db.Decimal(3, 2)
  totalReviews      Int         @default(0) @map("total_reviews")
  telegramGroupId   String?     @map("telegram_group_id") @db.VarChar(50)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  owner          User            @relation("StoreOwner", fields: [ownerId], references: [id])
  approvedBy     User?           @relation("StoreApprover", fields: [approvedById], references: [id])
  ward           Ward?           @relation(fields: [wardId], references: [id])
  province       Province?       @relation(fields: [provinceId], references: [id])
  workingHours   WorkingHour[]
  staff          Staff[]
  services       Service[]
  bookings       Booking[]
  reviews        Review[]
  roles              Role[]            @relation("StoreRoles")
  userRoles          UserRole[]        @relation("UserStoreRoles")
  storeCategories     ServiceCategory[] @relation("StoreCategories")
  staffInvites       StaffInvite[]
  staffSchedules StaffSchedule[]
  staffDayOffs   StaffDayOff[]
  conversations  Conversation[]
  coupons        Coupon[]        @relation("StoreCoupons")
  paymentConfig  StorePaymentConfig?

  @@index([ownerId])
  @@index([status])
  @@index([provinceId, wardId, status])
  @@map("stores")
}

// =============================================================================
// MODEL: WorkingHour (store open hours by day-of-week)
// =============================================================================

model WorkingHour {
  id        String    @id @default(uuid()) @db.Char(36)
  storeId   String    @map("store_id") @db.Char(36)
  dayOfWeek DayOfWeek @map("day_of_week")
  openTime  String    @map("open_time") @db.VarChar(5) // "08:00"
  closeTime String    @map("close_time") @db.VarChar(5) // "20:00"
  isClosed  Boolean   @default(false) @map("is_closed")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dayOfWeek])
  @@index([storeId])
  @@map("working_hours")
}

// =============================================================================
// MODEL: Staff
// =============================================================================

model Staff {
  id                String      @id @default(uuid()) @db.Char(36)
  userId            String      @map("user_id") @db.Char(36)
  storeId           String      @map("store_id") @db.Char(36)
  specialty         String?     @db.VarChar(200)
  bio               String?     @db.Text
  rating            Decimal     @default(0.00) @db.Decimal(3, 2)
  totalReviews      Int         @default(0) @map("total_reviews")
  status            StaffStatus @default(ACTIVE)
  telegramChatId    String?     @map("telegram_chat_id") @db.VarChar(50)
  telegramLinkToken String?     @map("telegram_link_token") @db.VarChar(100)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user                  User            @relation(fields: [userId], references: [id])
  store                 Store           @relation(fields: [storeId], references: [id])
  bookingItems          BookingItem[]
  reviews               Review[]        @relation("StaffReviews")
  schedules             StaffSchedule[]
  dayOffs               StaffDayOff[]
  services              StaffService[]
  invites               StaffInvite[]
  assignedConversations Conversation[]  @relation("AssignedConversations")

  @@unique([userId, storeId])
  @@index([storeId, status])
  @@map("staff")
}

// =============================================================================
// MODEL: ServiceCategory
// =============================================================================

model ServiceCategory {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @db.VarChar(100)
  slug        String?  @unique @db.VarChar(120)
  description String?
  iconUrl     String?  @map("icon_url")
  storeId     String?  @map("store_id") @db.Char(36)
  parentId    String?  @map("parent_id") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store    Store?            @relation("StoreCategories", fields: [storeId], references: [id])
  parent   ServiceCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ServiceCategory[] @relation("CategoryTree")
  services Service[]

  @@unique([name, storeId])
  @@index([storeId])
  @@index([parentId])
  @@map("service_categories")
}

// =============================================================================
// MODEL: Service
// =============================================================================

model Service {
  id          String        @id @default(uuid()) @db.Char(36)
  storeId     String        @map("store_id") @db.Char(36)
  categoryId  String?       @map("category_id") @db.Char(36)
  name        String        @db.VarChar(150)
  slug        String?       @db.VarChar(200)
  description String?       @db.Text
  imageUrls   Json?         @default("[]") @map("image_urls")
  status      ServiceStatus @default(ACTIVE)
  avgRating   Decimal       @default(0.00) @map("avg_rating") @db.Decimal(3, 2)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  store        Store            @relation(fields: [storeId], references: [id])
  category     ServiceCategory? @relation(fields: [categoryId], references: [id])
  variants     ServiceVariant[]
  bookingItems BookingItem[]
  reviews      Review[]
  staffs       StaffService[]

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([categoryId])
  @@map("services")
}

// =============================================================================
// MODEL: ServiceVariant
// =============================================================================

model ServiceVariant {
  id          String        @id @default(uuid()) @db.Char(36)
  serviceId   String        @map("service_id") @db.Char(36)
  name        String        @db.VarChar(150)
  description String?       @db.Text
  duration    Int // minutes
  price       Decimal       @db.Decimal(12, 2)
  costPrice   Decimal?      @map("cost_price") @db.Decimal(12, 2)
  sortOrder   Int           @default(0) @map("sort_order")
  status      ServiceStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@index([serviceId, status])
  @@map("service_variants")
}

// =============================================================================
// MODEL: StaffService (join — which staff can perform which service)
// =============================================================================

model StaffService {
  staffId   String @map("staff_id") @db.Char(36)
  serviceId String @map("service_id") @db.Char(36)

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@map("staff_services")
}

// =============================================================================
// MODEL: StaffSchedule
// =============================================================================

model StaffSchedule {
  id        String    @id @default(uuid()) @db.Char(36)
  storeId   String    @map("store_id") @db.Char(36)
  staffId   String    @map("staff_id") @db.Char(36)
  dayOfWeek DayOfWeek @map("day_of_week")
  startTime String    @map("start_time") @db.VarChar(5) // "09:00"
  endTime   String    @map("end_time") @db.VarChar(5) // "18:00"
  isActive  Boolean   @default(true) @map("is_active")

  store Store @relation(fields: [storeId], references: [id])
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@index([storeId, dayOfWeek])
  @@map("staff_schedules")
}

// =============================================================================
// MODEL: StaffDayOff
// =============================================================================

model StaffDayOff {
  id      String   @id @default(uuid()) @db.Char(36)
  storeId String   @map("store_id") @db.Char(36)
  staffId String   @map("staff_id") @db.Char(36)
  date    DateTime @map("date") @db.Date
  reason  String?

  store Store @relation(fields: [storeId], references: [id])
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([storeId, date])
  @@map("staff_day_offs")
}

// =============================================================================
// MODEL: StaffInvite
// =============================================================================

model StaffInvite {
  id        String            @id @default(uuid()) @db.Char(36)
  storeId   String            @map("store_id") @db.Char(36)
  staffId   String?           @map("staff_id") @db.Char(36)
  email     String            @db.VarChar(150)
  token     String            @unique @db.VarChar(200)
  status    StaffInviteStatus @default(PENDING)
  expiresAt DateTime          @map("expires_at")
  createdAt DateTime          @default(now()) @map("created_at")

  store Store  @relation(fields: [storeId], references: [id])
  staff Staff? @relation(fields: [staffId], references: [id])

  @@index([email])
  @@index([storeId])
  @@map("staff_invites")
}

// =============================================================================
// MODEL: Booking (replaces Appointment — hỗ trợ nhiều dịch vụ trong 1 lần đặt)
// totalDuration + totalPrice là aggregate của tất cả BookingItems
// =============================================================================

model Booking {
  id                 String        @id @default(uuid()) @db.Char(36)
  customerId         String        @map("customer_id") @db.Char(36)
  storeId            String        @map("store_id") @db.Char(36)
  scheduledAt        DateTime      @map("scheduled_at") // giờ bắt đầu dịch vụ đầu tiên
  totalDuration      Int           @map("total_duration") // tổng phút của toàn bộ items
  totalPrice         Decimal       @map("total_price") @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  finalPrice         Decimal       @default(0) @map("final_price") @db.Decimal(12, 2)
  couponId           String?       @map("coupon_id") @db.Char(36)
  status             BookingStatus @default(PENDING)
  depositAmount      Decimal?      @map("deposit_amount") @db.Decimal(12, 2)
  depositDeadline    DateTime?     @map("deposit_deadline")
  depositPaidAt      DateTime?     @map("deposit_paid_at")
  notes              String?       @db.Text
  cancellationReason String?       @map("cancellation_reason") @db.Text
  confirmedAt        DateTime?     @map("confirmed_at")
  completedAt        DateTime?     @map("completed_at")
  cancelledAt        DateTime?     @map("cancelled_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  customer      User           @relation("CustomerBookings", fields: [customerId], references: [id])
  store         Store          @relation(fields: [storeId], references: [id])
  coupon        Coupon?        @relation(fields: [couponId], references: [id])
  items         BookingItem[]
  payments      Payment[]
  reviews       Review[]
  notifications Notification[]
  couponUsage   CouponUsage?

  @@index([customerId, status])
  @@index([storeId, status, scheduledAt])
  @@map("bookings")
}

// =============================================================================
// MODEL: BookingItem (1 dịch vụ trong 1 booking — thực hiện tuần tự)
// startTime = scheduledAt + sum(duration của các items trước đó)
// duration + price + serviceName + variantName + staffName là snapshot tại thời điểm đặt lịch
// =============================================================================

model BookingItem {
  id          String   @id @default(uuid()) @db.Char(36)
  bookingId   String   @map("booking_id") @db.Char(36)
  sortOrder   Int      @map("sort_order") // thứ tự thực hiện: 0, 1, 2...
  serviceId   String   @map("service_id") @db.Char(36)
  variantId   String   @map("variant_id") @db.Char(36)
  staffId     String?  @map("staff_id") @db.Char(36)
  startTime   DateTime @map("start_time") // UTC — thời điểm bắt đầu item này
  duration    Int // snapshot of variant.duration (phút)
  price       Decimal  @db.Decimal(12, 2) // snapshot of variant.price
  serviceName String   @map("service_name") @db.VarChar(150) // snapshot of service.name
  variantName String   @map("variant_name") @db.VarChar(150) // snapshot of variant.name
  staffName   String?  @map("staff_name") @db.VarChar(255) // snapshot of staff.user.fullName
  createdAt   DateTime @default(now()) @map("created_at")

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id])
  variant ServiceVariant @relation(fields: [variantId], references: [id])
  staff   Staff?         @relation(fields: [staffId], references: [id])
  review  Review?

  @@index([bookingId])
  @@index([staffId, startTime])
  @@map("booking_items")
}

// =============================================================================
// MODEL: Payment (gắn với Booking — 1 thanh toán cho toàn bộ booking)
// bookingId is NOT unique — allows retry (FAILED → new PENDING Payment record)
// vnpTxnRef format: "{bookingId}-{timestamp}" — unique per payment attempt
// =============================================================================

model Payment {
  id                 String        @id @default(uuid()) @db.Char(36)
  bookingId          String        @map("booking_id") @db.Char(36)
  customerId         String        @map("customer_id") @db.Char(36)
  amount             Decimal       @db.Decimal(12, 2)
  type               PaymentType   @default(FULL)
  method             PaymentMethod @default(SEPAY)
  status             PaymentStatus @default(PENDING)
  sepayCode          String?       @unique @map("sepay_code") @db.VarChar(20)
  sepayTransactionId String?       @map("sepay_transaction_id") @db.VarChar(50)
  sepayGateway       String?       @map("sepay_gateway") @db.VarChar(50)
  paidAt             DateTime?     @map("paid_at")
  failedReason       String?       @map("failed_reason") @db.VarChar(500)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  booking  Booking @relation(fields: [bookingId], references: [id])
  customer User    @relation(fields: [customerId], references: [id])

  @@index([bookingId])
  @@index([customerId, status])
  @@index([sepayCode])
  @@map("payments")
}

// =============================================================================
// MODEL: StorePaymentConfig (cấu hình thanh toán chuyển khoản của từng shop)
// =============================================================================

model StorePaymentConfig {
  id              String   @id @default(uuid()) @db.Char(36)
  storeId         String   @unique @map("store_id") @db.Char(36)
  bankBin         String   @map("bank_bin") @db.VarChar(10)
  bankAccountNo   String   @map("bank_account_no") @db.VarChar(30)
  bankAccountName String   @map("bank_account_name") @db.VarChar(100)
  sepayApiKey     String?  @map("sepay_api_key") @db.VarChar(200)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_payment_configs")
}

// =============================================================================
// MODEL: Review (1 review cho mỗi BookingItem — đánh giá từng dịch vụ riêng lẻ)
// serviceId, staffId, storeId denormalized để query nhanh không cần join
// =============================================================================

model Review {
  id            String   @id @default(uuid()) @db.Char(36)
  bookingItemId String   @unique @map("booking_item_id") @db.Char(36)
  bookingId     String   @map("booking_id") @db.Char(36)
  customerId    String   @map("customer_id") @db.Char(36)
  storeId       String   @map("store_id") @db.Char(36)
  serviceId     String   @map("service_id") @db.Char(36)
  staffId       String?  @map("staff_id") @db.Char(36)
  rating        Int // 1–5
  comment       String?  @db.Text
  isVisible     Boolean  @default(true) @map("is_visible")
  imageUrls     Json?    @map("image_urls")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id])
  booking     Booking     @relation(fields: [bookingId], references: [id])
  customer    User        @relation("CustomerReviews", fields: [customerId], references: [id])
  store       Store       @relation(fields: [storeId], references: [id])
  service     Service     @relation(fields: [serviceId], references: [id])
  staff       Staff?      @relation("StaffReviews", fields: [staffId], references: [id])

  @@index([storeId, isVisible, createdAt])
  @@index([serviceId, isVisible])
  @@index([staffId, isVisible])
  @@map("reviews")
}

// =============================================================================
// MODEL: Notification (in-app inbox)
// =============================================================================

model Notification {
  id        String           @id @default(uuid()) @db.Char(36)
  userId    String           @map("user_id") @db.Char(36)
  bookingId String?          @map("booking_id") @db.Char(36)
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String           @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// =============================================================================
// MODEL: PushSubscription (Web Push browser subscriptions)
// =============================================================================

model PushSubscription {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.Text
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// =============================================================================
// MODEL: Conversation
// =============================================================================

model Conversation {
  id              String           @id @default(uuid()) @db.Char(36)
  customerId      String           @map("customer_id") @db.Char(36)
  storeId         String           @map("store_id") @db.Char(36)
  mode            ConversationMode @default(BOT)
  assignedStaffId String?          @map("assigned_staff_id") @db.Char(36)
  telegramTopicId Int?             @map("telegram_topic_id")
  lastMessageAt   DateTime?        @map("last_message_at")
  lastMessageBody String?          @map("last_message_body") @db.VarChar(200)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  customer      User      @relation("CustomerConversations", fields: [customerId], references: [id])
  store         Store     @relation(fields: [storeId], references: [id])
  assignedStaff Staff?    @relation("AssignedConversations", fields: [assignedStaffId], references: [id])
  messages      Message[]

  @@unique([customerId, storeId])
  @@index([customerId, lastMessageAt])
  @@index([storeId, lastMessageAt])
  @@map("conversations")
}

// =============================================================================
// MODEL: Message
// =============================================================================

model Message {
  id             String     @id @default(uuid()) @db.Char(36)
  conversationId String     @map("conversation_id") @db.Char(36)
  senderId       String     @map("sender_id") @db.Char(36)
  senderType     SenderType @default(CUSTOMER) @map("sender_type")
  content        String     @db.Text
  isRead         Boolean    @default(false) @map("is_read")
  readAt         DateTime?  @map("read_at")
  createdAt      DateTime   @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// =============================================================================
// MODEL: Coupon
// =============================================================================

model Coupon {
  id           String     @id @default(uuid()) @db.Char(36)
  code         String     @unique @db.VarChar(50)
  type         CouponType
  value        Decimal    @db.Decimal(12, 2)
  minAmount    Decimal?   @map("min_amount") @db.Decimal(12, 2)
  maxDiscount  Decimal?   @map("max_discount") @db.Decimal(12, 2)
  usageLimit   Int?       @map("usage_limit")
  perUserLimit Int?       @map("per_user_limit")
  usedCount    Int        @default(0) @map("used_count")
  startAt      DateTime   @map("start_at")
  expiredAt    DateTime?  @map("expired_at")
  isActive     Boolean    @default(true) @map("is_active")
  storeId      String?    @map("store_id") @db.Char(36)
  createdById  String     @map("created_by_id") @db.Char(36)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  store     Store?        @relation("StoreCoupons", fields: [storeId], references: [id])
  createdBy User          @relation("CouponCreatedBy", fields: [createdById], references: [id])
  usages    CouponUsage[]
  bookings  Booking[]

  @@index([storeId, isActive])
  @@index([expiredAt, isActive])
  @@map("coupons")
}

// =============================================================================
// MODEL: CouponUsage
// =============================================================================

model CouponUsage {
  id        String   @id @default(uuid()) @db.Char(36)
  couponId  String   @map("coupon_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  bookingId String   @unique @map("booking_id") @db.Char(36)
  discount  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  coupon  Coupon  @relation(fields: [couponId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([couponId, userId])
  @@map("coupon_usages")
}

// =============================================================================
// MODEL: SystemLog
// =============================================================================

model SystemLog {
  id         String    @id @default(uuid()) @db.Char(36)
  type       LogType
  status     LogStatus @default(SUCCESS)
  actorId    String?   @map("actor_id") @db.Char(36)
  storeId    String?   @map("store_id") @db.Char(36)
  targetId   String?   @map("target_id") @db.Char(36)
  targetType String?   @map("target_type") @db.VarChar(50)
  metadata   Json?
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  requestId  String?   @map("request_id") @db.Char(36)
  createdAt  DateTime  @default(now()) @map("created_at")

  actor User? @relation("ActorLogs", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([storeId])
  @@index([storeId, createdAt])
  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([requestId])
  @@index([targetId, targetType])
  @@map("system_logs")
}
