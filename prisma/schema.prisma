// ============================================================
// BOOKING PLATFORM — PRISMA SCHEMA
// Updated with fixes:
//   1. StaffBookingStatus enum thay cho isActive boolean
//   2. AppointmentItem hỗ trợ parent-child cho combo expansion
//   3. Payment tách thành Payment (summary) + PaymentTransaction (audit trail)
//   4. Review thêm userId explicit
//   5. Conversation thêm assignedAt
//   6. Shop thêm timezone
//   7. Material.stockQuantity không nullable
//   8. Exclusion constraint comment hướng dẫn migration SQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum ComboStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentItemStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// [FIX 1] Tách rõ trạng thái StaffBooking thay vì dùng isActive boolean
// - ACTIVE    : staff đang giữ slot này
// - RELEASED  : staff được giải phóng nhưng appointment vẫn còn (vd: reassign)
// - CANCELLED : theo appointment bị cancel
// Lý do: isActive boolean làm mờ semantic — không biết false là soft-delete
// hay released. Enum buộc code phải explicit khi thay đổi trạng thái.
enum StaffBookingStatus {
  ACTIVE
  RELEASED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// [FIX 2] Thêm type cho từng transaction (charge, refund...)
// Lý do: Payment thực tế có nhiều lần thử, refund một phần —
// cần phân biệt từng transaction riêng biệt.
enum PaymentTransactionType {
  CHARGE
  REFUND
  PARTIAL_REFUND
}

enum ConversationStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum SenderType {
  CUSTOMER
  STAFF
  SYSTEM
}

enum NotificationType {
  APPOINTMENT
  PAYMENT
  SYSTEM
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MaterialUnit {
  ML
  GRAM
  PIECE
}

enum ShopStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentItemType {
  SERVICE
  COMBO
  COMBO_CHILD // [FIX 3] Item con được expand từ một COMBO parent
  CUSTOM
}

// ─── Models ──────────────────────────────────────────────────

model User {
  id       String     @id @default(uuid())
  email    String     @unique
  password String
  fullName String?
  phone    String?
  status   UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffServices StaffService[]

  appointments          Appointment[]     @relation("CustomerAppointments")
  staffAppointmentItems AppointmentItem[] @relation("StaffForAppointmentItem")
  staffBookings         StaffBooking[]

  telegramAccount TelegramAccount?
  notifications   Notification[]

  customerConversations Conversation[] @relation("CustomerConversations")
  staffConversations    Conversation[] @relation("StaffConversations")

  staffSchedules StaffSchedule[]
  staffDaysOff   StaffDayOff[]

  ownedShops Shop[]
  userRoles  UserRole[]

  reviews Review[] // [FIX 4] Relation ngược từ Review
}

model Shop {
  id      String     @id @default(uuid())
  name    String
  address String?
  phone   String?
  status  ShopStatus @default(ACTIVE)

  // [FIX 5] Thêm timezone để xử lý WorkingHour và StaffSchedule đúng múi giờ
  // Lý do: @db.Time không lưu timezone — nếu server deploy ở UTC mà không
  // có field này thì openTime "08:00" sẽ bị hiểu nhầm múi giờ.
  // Dùng IANA timezone string, vd: "Asia/Ho_Chi_Minh"
  timezone String @default("Asia/Ho_Chi_Minh")

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  categories     Category[]
  services       Service[]
  combos         Combo[]
  materials      Material[]
  workingHours   WorkingHour[]
  appointments   Appointment[]
  roles          Role[]
  userRoles      UserRole[]
  staffBookings  StaffBooking[]
  staffSchedules StaffSchedule[]
  staffDaysOff   StaffDayOff[]
}

model Role {
  id          String  @id @default(uuid())
  name        String
  code        String
  description String?
  isSystem    Boolean @default(false)

  shopId String?
  shop   Shop?   @relation(fields: [shopId], references: [id])

  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([code, shopId])
  @@index([code])
  @@index([shopId])
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String  @unique
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  shopId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, shopId, roleId])
  @@index([shopId, userId])
}

model Category {
  id          String  @id @default(uuid())
  name        String
  description String?

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  services Service[]
  combos   Combo[]
}

model Service {
  id                  String        @id @default(uuid())
  name                String
  description         String?
  duration            Int
  bufferBeforeMinutes Int           @default(0)
  bufferAfterMinutes  Int           @default(0)
  price               Decimal
  costPrice           Decimal?
  status              ServiceStatus @default(ACTIVE)
  shopId              String
  categoryId          String?

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  staffServices    StaffService[]
  appointmentItems AppointmentItem[]
  comboServices    ComboService[]
  materials        ServiceMaterial[]
}

model Combo {
  id                       String      @id @default(uuid())
  name                     String
  description              String?
  price                    Decimal
  estimatedDurationMinutes Int?
  status                   ComboStatus @default(ACTIVE)
  shopId                   String
  categoryId               String?

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  services         ComboService[]
  appointmentItems AppointmentItem[]
}

model ComboService {
  comboId   String
  serviceId String
  quantity  Int    @default(1)
  order     Int?

  combo   Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([comboId, serviceId])
}

model StaffService {
  staffId   String
  serviceId String

  staff   User    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model Appointment {
  id         String @id @default(uuid())
  shopId     String
  customerId String

  startTime DateTime @db.Timestamptz(3)
  endTime   DateTime @db.Timestamptz(3)

  status AppointmentStatus @default(PENDING)

  durationMinutes     Int
  bufferBeforeMinutes Int @default(0)
  bufferAfterMinutes  Int @default(0)

  currency String  @default("VND")
  subtotal Decimal
  discount Decimal @default(0)
  total    Decimal

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop     Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer User @relation("CustomerAppointments", fields: [customerId], references: [id])

  items         AppointmentItem[]
  staffBookings StaffBooking[]
  review        Review?
  payment       Payment?
  conversation  Conversation?

  @@index([shopId, customerId, startTime])
}

// [FIX 3] Thêm parentItemId để model quan hệ parent-child khi expand combo
// Khi user đặt 1 COMBO, hệ thống tạo:
//   - 1 item type=COMBO (parent, lưu comboId + price snapshot của cả combo)
//   - N item type=COMBO_CHILD (con, mỗi cái = 1 service trong combo,
//     có staffId + durationSnapshot riêng, parentItemId trỏ về COMBO parent)
// Lý do: COMBO thường gồm nhiều service do nhiều staff khác nhau thực hiện.
// Nếu gộp tất cả vào 1 item thì không thể assign staff riêng, track
// tiến độ từng service, hay tính buffer time chính xác.
model AppointmentItem {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  type   AppointmentItemType
  status AppointmentItemStatus @default(PENDING)

  // Parent-child cho combo expansion
  parentItemId String?
  parentItem   AppointmentItem?  @relation("ItemChildren", fields: [parentItemId], references: [id])
  childItems   AppointmentItem[] @relation("ItemChildren")

  staffId String?
  staff   User?   @relation("StaffForAppointmentItem", fields: [staffId], references: [id])

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  comboId String?
  combo   Combo?  @relation(fields: [comboId], references: [id])

  // Snapshot tại thời điểm đặt — không đổi dù shop cập nhật giá/tên sau này
  nameSnapshot         String
  durationSnapshot     Int
  bufferBeforeSnapshot Int     @default(0)
  bufferAfterSnapshot  Int     @default(0)
  unitPriceSnapshot    Decimal
  quantity             Int     @default(1)

  sortOrder Int?

  createdAt DateTime @default(now())

  staffBookings StaffBooking[]

  @@unique([appointmentId, sortOrder])
  @@index([appointmentId])
  @@index([status])
  @@index([staffId])
  @@index([serviceId])
  @@index([comboId])
  @@index([parentItemId])
}

// [FIX 1] isActive boolean → status enum StaffBookingStatus
// Đồng thời thêm index trên status để query slot trống nhanh hơn.
//
// [IMPORTANT — Migration SQL cần thêm thủ công]
// Prisma không support EXCLUDE constraint. Sau khi chạy prisma migrate,
// thêm vào file migration SQL:
//
//   CREATE EXTENSION IF NOT EXISTS btree_gist;
//
//   ALTER TABLE "StaffBooking"
//   ADD CONSTRAINT no_overlap_staff_booking
//   EXCLUDE USING gist (
//     "staffId" WITH =,
//     tstzrange("startTime", "endTime", '[)') WITH &&
//   )
//   WHERE (status = 'ACTIVE');
//
// Constraint này đảm bảo DB-level: không có 2 StaffBooking ACTIVE nào
// của cùng 1 staff mà thời gian chồng nhau — safety net khi Redis lock miss.
model StaffBooking {
  id     String @id @default(uuid())
  shopId String
  staffId String

  appointmentId     String
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  appointmentItemId String?
  appointmentItem   AppointmentItem? @relation(fields: [appointmentItemId], references: [id], onDelete: Cascade)

  startTime DateTime @db.Timestamptz(3)
  endTime   DateTime @db.Timestamptz(3)

  status StaffBookingStatus @default(ACTIVE)

  staff User @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shop  Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([shopId, staffId, startTime])
  @@index([shopId, staffId, status])
  @@index([appointmentId])
  @@index([appointmentItemId])
  @@index([staffId, startTime, endTime])
}

// [FIX 2] Tách Payment thành 2 tầng:
// - Payment     : summary record, 1-1 với Appointment
// - PaymentTransaction : mỗi lần charge/refund là 1 row riêng
// Lý do: payment thực tế có thể fail rồi retry, refund một phần,
// có nhiều providerTxnId khác nhau từ VNPay/Stripe. Chỉ có 1 row
// thì không audit trail được.
model Payment {
  id            String @id @default(uuid())
  appointmentId String @unique

  method String?
  amount Decimal

  status PaymentStatus @default(PENDING)
  paidAt DateTime?

  appointment  Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]
}

model PaymentTransaction {
  id        String @id @default(uuid())
  paymentId String

  type   PaymentTransactionType
  status PaymentStatus

  amount        Decimal
  providerTxnId String? // Transaction ID từ VNPay / Stripe / MoMo
  rawResponse   Json?   // Lưu raw webhook payload để debug / reconcile

  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([providerTxnId])
}

// [FIX 4] Thêm userId explicit thay vì chỉ derive qua appointment.customerId
// Lý do: query "tất cả review của user X" sẽ phải JOIN qua Appointment
// nếu không có field này — chậm và verbose không cần thiết.
model Review {
  id            String @id @default(uuid())
  appointmentId String @unique
  userId        String

  rating  Int
  comment String?

  createdAt DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@index([userId])
}

// [FIX 6] Thêm assignedAt để track thời điểm staff tiếp nhận conversation
// Lý do: cần đo SLA (thời gian phản hồi lần đầu). Nếu staffId có mà
// không có assignedAt thì không biết staff nhận từ lúc nào.
model Conversation {
  id String @id @default(uuid())

  customerId    String
  staffId       String?
  appointmentId String? @unique

  status     ConversationStatus @default(OPEN)
  assignedAt DateTime? // null = chưa có staff tiếp nhận

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    User         @relation("CustomerConversations", fields: [customerId], references: [id])
  staff       User?        @relation("StaffConversations", fields: [staffId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  messages Message[]
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderType     SenderType
  senderId       String?
  content        String
  messageType    MessageType @default(TEXT)
  telegramMsgId  BigInt?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model TelegramAccount {
  staffId        String  @id
  telegramUserId BigInt  @unique
  username       String?

  staff User @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Notification {
  id      String           @id @default(uuid())
  userId  String
  type    NotificationType
  title   String
  content String
  isRead  Boolean          @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model WorkingHour {
  id     String @id @default(uuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  dayOfWeek DayOfWeek
  openTime  DateTime  @db.Time(0)
  closeTime DateTime  @db.Time(0)
  isClosed  Boolean   @default(false)

  @@index([shopId, dayOfWeek])
}

model StaffSchedule {
  id        String @id @default(uuid())
  staffId   String
  shopId    String
  dayOfWeek DayOfWeek

  startTime DateTime @db.Time(0)
  endTime   DateTime @db.Time(0)

  isActive Boolean @default(true)

  staff User @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shop  Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, staffId, dayOfWeek, startTime, endTime])
  @@index([shopId, staffId, dayOfWeek])
}

model StaffDayOff {
  id      String @id @default(uuid())
  staffId String
  shopId  String
  date    DateTime @db.Date
  reason  String?

  staff User @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shop  Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, staffId, date])
}

// [FIX 7] stockQuantity đổi sang Float @default(0) — không nullable
// Lý do: nullable Float buộc mọi chỗ dùng phải xử lý null trước khi
// tính toán tồn kho. Giá trị mặc định 0 rõ ràng hơn về mặt business:
// "chưa có hàng" khác với "không biết có hàng không".
model Material {
  id          String      @id @default(uuid())
  name        String
  description String?
  unit        MaterialUnit
  costPrice   Decimal
  stockQuantity Float    @default(0)
  shopId      String
  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)

  serviceMaterials ServiceMaterial[]
}

model ServiceMaterial {
  id         String @id @default(uuid())
  serviceId  String
  materialId String
  quantity   Float

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([serviceId, materialId])
}
