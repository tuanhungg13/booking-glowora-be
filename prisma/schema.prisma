// ============================================================
// GLOWORA BOOKING PLATFORM — COMPLETE SCHEMA (All Phases)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
  SUSPENDED
}

enum StoreStatus {
  PENDING
  ACTIVE
  INACTIVE
  BANNED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  VNPAY
  STRIPE
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_REJECTED
  BOOKING_COMPLETED
  BOOKING_CANCELLED
  STORE_APPROVED
  STORE_REJECTED
  STORE_LOCKED
  STAFF_INVITED
  PAYMENT_SUCCESS
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum ComboStatus {
  ACTIVE
  INACTIVE
}

enum StaffInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum LogType {
  AUTH_REGISTER
  AUTH_LOGIN
  AUTH_LOGOUT
  STORE_CREATED
  STORE_APPROVED
  STORE_REJECTED
  STORE_BANNED
  STORE_UNLOCKED
  USER_BANNED
  USER_UNBANNED
  PAYMENT_COMPLETED
  PAYMENT_FAILED
  REVIEW_HIDDEN
  REVIEW_SHOWN
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_REJECTED
  BOOKING_COMPLETED
  BOOKING_CANCELLED
}

enum ConversationMode {
  BOT
  HUMAN
}

enum SenderType {
  CUSTOMER
  STAFF
  BOT
}

// =============================================================================
// RBAC: Role, Permission, RolePermission, UserRole
// =============================================================================

model Role {
  id          String  @id @default(uuid()) @db.Char(36)
  name        String  @db.VarChar(100)
  code        String  @db.VarChar(50)
  description String?
  isSystem    Boolean @default(false) @map("is_system")
  shopId      String? @map("shop_id") @db.Char(36)

  shop        Store?           @relation("ShopRoles", fields: [shopId], references: [id])
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([code, shopId])
  @@index([shopId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Char(36)
  code        String  @unique @db.VarChar(100)
  name        String  @db.VarChar(150)
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Char(36)
  permissionId String @map("permission_id") @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  roleId    String   @map("role_id") @db.Char(36)
  shopId    String?  @map("shop_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role   @relation(fields: [roleId], references: [id])
  shop Store? @relation("UserShopRoles", fields: [shopId], references: [id])

  // Note: MySQL treats NULL != NULL so unique on nullable shopId is enforced in code for system roles
  @@unique([userId, roleId, shopId])
  @@index([userId])
  @@index([shopId])
  @@map("user_roles")
}

// =============================================================================
// MODEL: User
// =============================================================================

model User {
  id           String     @id @default(uuid()) @db.Char(36)
  fullName     String     @map("full_name") @db.VarChar(100)
  email        String     @unique @db.VarChar(150)
  password     String
  phone        String?    @db.VarChar(20)
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(ACTIVE)
  refreshToken String?    @map("refresh_token")
  bannedAt     DateTime?  @map("banned_at")
  banReason    String?    @map("ban_reason") @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  userRoles      UserRole[]
  ownedStores    Store[]        @relation("StoreOwner")
  approvedStores Store[]        @relation("StoreApprover")
  staffProfiles  Staff[]
  bookings       Booking[]      @relation("CustomerBookings")
  payments       Payment[]
  reviews        Review[]       @relation("CustomerReviews")
  notifications  Notification[]
  conversations  Conversation[] @relation("CustomerConversations")
  sentMessages   Message[]      @relation("SentMessages")
  systemLogs     SystemLog[]    @relation("ActorLogs")

  @@map("users")
}

// =============================================================================
// MODEL: Province (Tỉnh / Thành phố)
// =============================================================================

model Province {
  id     Int    @id
  code   String @unique @db.Char(2)
  name   String @db.VarChar(100)
  type   String @db.VarChar(10)

  wards  Ward[]
  stores Store[]

  @@map("provinces")
}

// =============================================================================
// MODEL: Ward (Xã / Phường / Đặc khu)
// =============================================================================

model Ward {
  id         Int      @id
  provinceId Int      @map("province_id")
  name       String   @db.VarChar(100)
  type       String   @db.VarChar(10)

  province   Province @relation(fields: [provinceId], references: [id])
  stores     Store[]

  @@index([provinceId])
  @@map("wards")
}

// =============================================================================
// MODEL: Store
// =============================================================================

model Store {
  id                String      @id @default(uuid()) @db.Char(36)
  slug              String?     @unique @db.VarChar(200)
  ownerId           String      @map("owner_id") @db.Char(36)
  name              String      @db.VarChar(150)
  phone             String      @db.VarChar(20)
  email             String?     @db.VarChar(150)
  website           String?     @db.VarChar(200)
  description       String?     @db.Text
  address           String      @db.VarChar(300)
  district          String?     @db.VarChar(100)
  wardId            Int?        @map("ward_id")
  provinceId        Int?        @map("province_id")
  latitude          Float?
  longitude         Float?
  logoUrl           String?     @map("logo_url")
  bannerUrl         String?     @map("banner_url")
  status            StoreStatus @default(PENDING)
  approvedById      String?     @map("approved_by_id") @db.Char(36)
  approvedAt        DateTime?   @map("approved_at")
  rejectionReason   String?     @map("rejection_reason") @db.Text
  timezone          String      @default("Asia/Ho_Chi_Minh") @db.VarChar(50)
  slotIntervalMins  Int         @default(30) @map("slot_interval_mins")
  cancelBeforeHours Int         @default(2) @map("cancel_before_hours")
  maxAdvanceDays    Int         @default(30) @map("max_advance_days")
  bookingBufferMins Int         @default(30) @map("booking_buffer_mins")
  autoConfirm       Boolean     @default(false) @map("auto_confirm")
  avgRating         Decimal     @default(0.00) @map("avg_rating") @db.Decimal(3, 2)
  totalReviews      Int         @default(0) @map("total_reviews")
  telegramGroupId   String?     @map("telegram_group_id") @db.VarChar(50)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  owner          User            @relation("StoreOwner", fields: [ownerId], references: [id])
  approvedBy     User?           @relation("StoreApprover", fields: [approvedById], references: [id])
  ward           Ward?           @relation(fields: [wardId], references: [id])
  province       Province?       @relation(fields: [provinceId], references: [id])
  workingHours   WorkingHour[]
  staff          Staff[]
  services       Service[]
  bookings       Booking[]
  reviews        Review[]
  roles          Role[]          @relation("ShopRoles")
  userRoles      UserRole[]      @relation("UserShopRoles")
  combos             Combo[]
  shopCategories     ServiceCategory[] @relation("ShopCategories")
  staffInvites       StaffInvite[]
  staffSchedules StaffSchedule[]
  staffDayOffs   StaffDayOff[]
  conversations  Conversation[]

  @@index([ownerId])
  @@index([status])
  @@index([provinceId, wardId, status])
  @@map("stores")
}

// =============================================================================
// MODEL: WorkingHour (store open hours by day-of-week)
// =============================================================================

model WorkingHour {
  id        String    @id @default(uuid()) @db.Char(36)
  storeId   String    @map("store_id") @db.Char(36)
  dayOfWeek DayOfWeek @map("day_of_week")
  openTime  String    @map("open_time") @db.VarChar(5) // "08:00"
  closeTime String    @map("close_time") @db.VarChar(5) // "20:00"
  isClosed  Boolean   @default(false) @map("is_closed")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dayOfWeek])
  @@index([storeId])
  @@map("working_hours")
}

// =============================================================================
// MODEL: Staff
// =============================================================================

model Staff {
  id                String      @id @default(uuid()) @db.Char(36)
  userId            String      @map("user_id") @db.Char(36)
  storeId           String      @map("store_id") @db.Char(36)
  specialty         String?     @db.VarChar(200)
  bio               String?     @db.Text
  rating            Decimal     @default(0.00) @db.Decimal(3, 2)
  totalReviews      Int         @default(0) @map("total_reviews")
  status            StaffStatus @default(ACTIVE)
  telegramChatId    String?     @map("telegram_chat_id") @db.VarChar(50)
  telegramLinkToken String?     @map("telegram_link_token") @db.VarChar(100)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user                  User            @relation(fields: [userId], references: [id])
  store                 Store           @relation(fields: [storeId], references: [id])
  bookingItems          BookingItem[]
  reviews               Review[]        @relation("StaffReviews")
  schedules             StaffSchedule[]
  dayOffs               StaffDayOff[]
  services              StaffService[]
  invites               StaffInvite[]
  assignedConversations Conversation[]  @relation("AssignedConversations")

  @@unique([userId, storeId])
  @@index([storeId, status])
  @@map("staff")
}

// =============================================================================
// MODEL: ServiceCategory
// =============================================================================

model ServiceCategory {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @db.VarChar(100)
  slug        String?  @unique @db.VarChar(120)
  description String?
  iconUrl     String?  @map("icon_url")
  shopId      String?  @map("shop_id") @db.Char(36)
  parentId    String?  @map("parent_id") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop     Store?            @relation("ShopCategories", fields: [shopId], references: [id])
  parent   ServiceCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ServiceCategory[] @relation("CategoryTree")
  services Service[]
  combos   Combo[]

  @@unique([name, shopId])
  @@index([shopId])
  @@index([parentId])
  @@map("service_categories")
}

// =============================================================================
// MODEL: Service
// =============================================================================

model Service {
  id          String        @id @default(uuid()) @db.Char(36)
  shopId      String        @map("shop_id") @db.Char(36)
  categoryId  String?       @map("category_id") @db.Char(36)
  name        String        @db.VarChar(150)
  slug        String?       @db.VarChar(200)
  description String?       @db.Text
  imageUrl    String?       @map("image_url")
  status      ServiceStatus @default(ACTIVE)
  avgRating   Decimal       @default(0.00) @map("avg_rating") @db.Decimal(3, 2)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  store        Store            @relation(fields: [shopId], references: [id])
  category     ServiceCategory? @relation(fields: [categoryId], references: [id])
  variants     ServiceVariant[]
  bookingItems BookingItem[]
  reviews      Review[]
  staffs       StaffService[]
  comboItems   ComboItem[]

  @@unique([shopId, slug])
  @@index([shopId, status])
  @@index([categoryId])
  @@map("services")
}

// =============================================================================
// MODEL: ServiceVariant
// =============================================================================

model ServiceVariant {
  id          String        @id @default(uuid()) @db.Char(36)
  serviceId   String        @map("service_id") @db.Char(36)
  name        String        @db.VarChar(150)
  description String?       @db.Text
  duration    Int // minutes
  price       Decimal       @db.Decimal(12, 2)
  costPrice   Decimal?      @map("cost_price") @db.Decimal(12, 2)
  sortOrder   Int           @default(0) @map("sort_order")
  status      ServiceStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@index([serviceId, status])
  @@map("service_variants")
}

// =============================================================================
// MODEL: StaffService (join — which staff can perform which service)
// =============================================================================

model StaffService {
  staffId   String @map("staff_id") @db.Char(36)
  serviceId String @map("service_id") @db.Char(36)

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@map("staff_services")
}

// =============================================================================
// MODEL: Combo
// =============================================================================

model Combo {
  id                       String      @id @default(uuid()) @db.Char(36)
  shopId                   String      @map("shop_id") @db.Char(36)
  categoryId               String?     @map("category_id") @db.Char(36)
  name                     String      @db.VarChar(150)
  description              String?     @db.Text
  price                    Decimal     @db.Decimal(12, 2)
  estimatedDurationMinutes Int?        @map("estimated_duration_minutes")
  imageUrl                 String?     @map("image_url")
  status                   ComboStatus @default(ACTIVE)
  createdAt                DateTime    @default(now()) @map("created_at")
  updatedAt                DateTime    @updatedAt @map("updated_at")

  shop     Store            @relation(fields: [shopId], references: [id])
  category ServiceCategory? @relation(fields: [categoryId], references: [id])
  items    ComboItem[]

  @@index([shopId, status])
  @@map("combos")
}

// =============================================================================
// MODEL: ComboItem
// =============================================================================

model ComboItem {
  id        String @id @default(uuid()) @db.Char(36)
  comboId   String @map("combo_id") @db.Char(36)
  serviceId String @map("service_id") @db.Char(36)
  quantity  Int    @default(1)
  sortOrder Int    @default(0) @map("sort_order")

  combo   Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@unique([comboId, serviceId])
  @@index([comboId])
  @@map("combo_items")
}

// =============================================================================
// MODEL: StaffSchedule
// =============================================================================

model StaffSchedule {
  id        String    @id @default(uuid()) @db.Char(36)
  shopId    String    @map("shop_id") @db.Char(36)
  staffId   String    @map("staff_id") @db.Char(36)
  dayOfWeek DayOfWeek @map("day_of_week")
  startTime String    @map("start_time") @db.VarChar(5) // "09:00"
  endTime   String    @map("end_time") @db.VarChar(5) // "18:00"
  isActive  Boolean   @default(true) @map("is_active")

  shop  Store @relation(fields: [shopId], references: [id])
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@index([shopId, dayOfWeek])
  @@map("staff_schedules")
}

// =============================================================================
// MODEL: StaffDayOff
// =============================================================================

model StaffDayOff {
  id      String   @id @default(uuid()) @db.Char(36)
  shopId  String   @map("shop_id") @db.Char(36)
  staffId String   @map("staff_id") @db.Char(36)
  date    DateTime @map("date") @db.Date
  reason  String?

  shop  Store @relation(fields: [shopId], references: [id])
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([shopId, date])
  @@map("staff_day_offs")
}

// =============================================================================
// MODEL: StaffInvite
// =============================================================================

model StaffInvite {
  id        String            @id @default(uuid()) @db.Char(36)
  storeId   String            @map("store_id") @db.Char(36)
  staffId   String?           @map("staff_id") @db.Char(36)
  email     String            @db.VarChar(150)
  token     String            @unique @db.VarChar(200)
  status    StaffInviteStatus @default(PENDING)
  expiresAt DateTime          @map("expires_at")
  createdAt DateTime          @default(now()) @map("created_at")

  store Store  @relation(fields: [storeId], references: [id])
  staff Staff? @relation(fields: [staffId], references: [id])

  @@index([email])
  @@index([storeId])
  @@map("staff_invites")
}

// =============================================================================
// MODEL: Booking (replaces Appointment — hỗ trợ nhiều dịch vụ trong 1 lần đặt)
// totalDuration + totalPrice là aggregate của tất cả BookingItems
// =============================================================================

model Booking {
  id                 String        @id @default(uuid()) @db.Char(36)
  customerId         String        @map("customer_id") @db.Char(36)
  storeId            String        @map("store_id") @db.Char(36)
  scheduledAt        DateTime      @map("scheduled_at") // giờ bắt đầu dịch vụ đầu tiên
  totalDuration      Int           @map("total_duration") // tổng phút của toàn bộ items
  totalPrice         Decimal       @map("total_price") @db.Decimal(12, 2)
  status             BookingStatus @default(PENDING)
  notes              String?       @db.Text
  cancellationReason String?       @map("cancellation_reason") @db.Text
  confirmedAt        DateTime?     @map("confirmed_at")
  completedAt        DateTime?     @map("completed_at")
  cancelledAt        DateTime?     @map("cancelled_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  customer      User           @relation("CustomerBookings", fields: [customerId], references: [id])
  store         Store          @relation(fields: [storeId], references: [id])
  items         BookingItem[]
  payments      Payment[]
  reviews       Review[]
  notifications Notification[]

  @@index([customerId, status])
  @@index([storeId, status, scheduledAt])
  @@map("bookings")
}

// =============================================================================
// MODEL: BookingItem (1 dịch vụ trong 1 booking — thực hiện tuần tự)
// startTime = scheduledAt + sum(duration của các items trước đó)
// duration + price là snapshot tại thời điểm đặt lịch
// =============================================================================

model BookingItem {
  id        String   @id @default(uuid()) @db.Char(36)
  bookingId String   @map("booking_id") @db.Char(36)
  sortOrder Int      @map("sort_order") // thứ tự thực hiện: 0, 1, 2...
  serviceId String   @map("service_id") @db.Char(36)
  variantId String   @map("variant_id") @db.Char(36)
  staffId   String?  @map("staff_id") @db.Char(36)
  startTime DateTime @map("start_time") // UTC — thời điểm bắt đầu item này
  duration  Int // snapshot of variant.duration (phút)
  price     Decimal  @db.Decimal(12, 2) // snapshot of variant.price
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id])
  variant ServiceVariant @relation(fields: [variantId], references: [id])
  staff   Staff?         @relation(fields: [staffId], references: [id])
  review  Review?

  @@index([bookingId])
  @@index([staffId, startTime])
  @@map("booking_items")
}

// =============================================================================
// MODEL: Payment (gắn với Booking — 1 thanh toán cho toàn bộ booking)
// bookingId is NOT unique — allows retry (FAILED → new PENDING Payment record)
// vnpTxnRef format: "{bookingId}-{timestamp}" — unique per payment attempt
// =============================================================================

model Payment {
  id               String        @id @default(uuid()) @db.Char(36)
  bookingId        String        @map("booking_id") @db.Char(36)
  customerId       String        @map("customer_id") @db.Char(36)
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod @default(VNPAY)
  status           PaymentStatus @default(PENDING)
  vnpTxnRef        String?       @unique @map("vnp_txn_ref") @db.VarChar(100)
  vnpTransactionNo String?       @map("vnp_transaction_no") @db.VarChar(100)
  vnpBankCode      String?       @map("vnp_bank_code") @db.VarChar(20)
  vnpCardType      String?       @map("vnp_card_type") @db.VarChar(20)
  vnpPayDate       String?       @map("vnp_pay_date") @db.VarChar(20)
  vnpResponseCode  String?       @map("vnp_response_code") @db.VarChar(10)
  paidAt           DateTime?     @map("paid_at")
  failedReason     String?       @map("failed_reason") @db.VarChar(500)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  booking  Booking @relation(fields: [bookingId], references: [id])
  customer User    @relation(fields: [customerId], references: [id])

  @@index([bookingId])
  @@index([customerId, status])
  @@map("payments")
}

// =============================================================================
// MODEL: Review (1 review cho mỗi BookingItem — đánh giá từng dịch vụ riêng lẻ)
// serviceId, staffId, storeId denormalized để query nhanh không cần join
// =============================================================================

model Review {
  id            String   @id @default(uuid()) @db.Char(36)
  bookingItemId String   @unique @map("booking_item_id") @db.Char(36)
  bookingId     String   @map("booking_id") @db.Char(36)
  customerId    String   @map("customer_id") @db.Char(36)
  storeId       String   @map("store_id") @db.Char(36)
  serviceId     String   @map("service_id") @db.Char(36)
  staffId       String?  @map("staff_id") @db.Char(36)
  rating        Int // 1–5
  comment       String?  @db.Text
  isVisible     Boolean  @default(true) @map("is_visible")
  imageUrls     Json?    @map("image_urls")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id])
  booking     Booking     @relation(fields: [bookingId], references: [id])
  customer    User        @relation("CustomerReviews", fields: [customerId], references: [id])
  store       Store       @relation(fields: [storeId], references: [id])
  service     Service     @relation(fields: [serviceId], references: [id])
  staff       Staff?      @relation("StaffReviews", fields: [staffId], references: [id])

  @@index([storeId, isVisible, createdAt])
  @@index([serviceId, isVisible])
  @@index([staffId, isVisible])
  @@map("reviews")
}

// =============================================================================
// MODEL: Notification (in-app inbox)
// =============================================================================

model Notification {
  id        String           @id @default(uuid()) @db.Char(36)
  userId    String           @map("user_id") @db.Char(36)
  bookingId String?          @map("booking_id") @db.Char(36)
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String           @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// =============================================================================
// MODEL: Conversation
// =============================================================================

model Conversation {
  id              String           @id @default(uuid()) @db.Char(36)
  customerId      String           @map("customer_id") @db.Char(36)
  storeId         String           @map("store_id") @db.Char(36)
  mode            ConversationMode @default(BOT)
  assignedStaffId String?          @map("assigned_staff_id") @db.Char(36)
  telegramTopicId Int?             @map("telegram_topic_id")
  lastMessageAt   DateTime?        @map("last_message_at")
  lastMessageBody String?          @map("last_message_body") @db.VarChar(200)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  customer      User      @relation("CustomerConversations", fields: [customerId], references: [id])
  store         Store     @relation(fields: [storeId], references: [id])
  assignedStaff Staff?    @relation("AssignedConversations", fields: [assignedStaffId], references: [id])
  messages      Message[]

  @@unique([customerId, storeId])
  @@index([customerId, lastMessageAt])
  @@index([storeId, lastMessageAt])
  @@map("conversations")
}

// =============================================================================
// MODEL: Message
// =============================================================================

model Message {
  id             String     @id @default(uuid()) @db.Char(36)
  conversationId String     @map("conversation_id") @db.Char(36)
  senderId       String     @map("sender_id") @db.Char(36)
  senderType     SenderType @default(CUSTOMER) @map("sender_type")
  content        String     @db.Text
  isRead         Boolean    @default(false) @map("is_read")
  readAt         DateTime?  @map("read_at")
  createdAt      DateTime   @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// =============================================================================
// MODEL: SystemLog
// =============================================================================

model SystemLog {
  id         String   @id @default(uuid()) @db.Char(36)
  type       LogType
  actorId    String?  @map("actor_id") @db.Char(36)
  targetId   String?  @map("target_id") @db.Char(36)
  targetType String?  @map("target_type") @db.VarChar(50)
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("ActorLogs", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([type, createdAt])
  @@index([targetId, targetType])
  @@map("system_logs")
}
