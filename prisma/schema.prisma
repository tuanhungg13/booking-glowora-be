// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum ComboStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentItemStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ConversationStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum SenderType {
  CUSTOMER
  STAFF
  SYSTEM
}

enum NotificationType {
  APPOINTMENT
  PAYMENT
  SYSTEM
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MaterialUnit {
  ML
  GRAM
  PIECE
}

enum ShopStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentItemType {
  SERVICE
  COMBO
  CUSTOM
}

model User {
  id       String     @id @default(uuid())
  email    String     @unique
  password String
  fullName String?
  phone    String?
  status   UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffServices StaffService[]

  appointments          Appointment[]     @relation("CustomerAppointments")
  staffAppointmentItems AppointmentItem[] @relation("StaffForAppointmentItem")
  staffBookings         StaffBooking[]

  telegramAccount TelegramAccount?

  notifications Notification[]

  customerConversations Conversation[] @relation("CustomerConversations")
  staffConversations    Conversation[] @relation("StaffConversations")

  staffSchedules StaffSchedule[]
  staffDaysOff   StaffDayOff[]

  ownedShops Shop[]
  userRoles  UserRole[]
}

model Shop {
  id      String     @id @default(uuid())
  name    String
  address String?
  phone   String?
  status  ShopStatus @default(ACTIVE)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  categories     Category[]
  services       Service[]
  combos         Combo[]
  materials      Material[]
  workingHours   WorkingHour[]
  appointments   Appointment[]
  roles          Role[]
  userRoles      UserRole[]
  staffBookings  StaffBooking[]
  staffSchedules StaffSchedule[]
  staffDaysOff   StaffDayOff[]
}

model Role {
  id          String  @id @default(uuid())
  name        String
  code        String
  description String?

  isSystem Boolean @default(false)

  shopId String?
  shop   Shop?   @relation(fields: [shopId], references: [id])

  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([code, shopId])
  @@index([code])
  @@index([shopId])
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String  @unique
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  shopId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, shopId, roleId])
  @@index([shopId, userId])
}

model Category {
  id          String  @id @default(uuid())
  name        String
  description String?

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  services Service[]
  combos   Combo[]
}

model Service {
  id                  String        @id @default(uuid())
  name                String
  description         String?
  duration            Int
  bufferBeforeMinutes Int           @default(0)
  bufferAfterMinutes  Int           @default(0)
  price               Decimal
  costPrice           Decimal?
  status              ServiceStatus @default(ACTIVE)
  shopId              String
  categoryId          String?

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  staffServices    StaffService[]
  appointmentItems AppointmentItem[]
  comboServices    ComboService[]

  materials ServiceMaterial[]
}

model Combo {
  id                       String      @id @default(uuid())
  name                     String
  description              String?
  price                    Decimal
  estimatedDurationMinutes Int?
  status                   ComboStatus @default(ACTIVE)
  shopId                   String
  categoryId               String?

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  services         ComboService[]
  appointmentItems AppointmentItem[]
}

model ComboService {
  comboId   String
  serviceId String
  quantity  Int    @default(1)
  order     Int?

  combo   Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([comboId, serviceId])
}

model StaffService {
  staffId   String
  serviceId String

  staff   User    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model Appointment {
  id String @id @default(uuid())

  shopId String

  customerId String

  startTime DateTime @db.Timestamptz(3)
  endTime   DateTime @db.Timestamptz(3)

  status AppointmentStatus @default(PENDING)

  durationMinutes     Int
  bufferBeforeMinutes Int @default(0)
  bufferAfterMinutes  Int @default(0)

  currency String @default("VND")

  subtotal Decimal
  discount Decimal @default(0)
  total    Decimal

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  customer User @relation("CustomerAppointments", fields: [customerId], references: [id])

  items         AppointmentItem[]
  staffBookings StaffBooking[]
  review        Review?
  payment       Payment?
  conversation  Conversation?

  @@index([shopId, customerId, startTime])
}

model AppointmentItem {
  id String @id @default(uuid())

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  type AppointmentItemType

  status AppointmentItemStatus @default(PENDING)

  staffId String?
  staff   User?   @relation("StaffForAppointmentItem", fields: [staffId], references: [id])

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  comboId String?
  combo   Combo?  @relation(fields: [comboId], references: [id])

  nameSnapshot         String
  durationSnapshot     Int
  bufferBeforeSnapshot Int     @default(0)
  bufferAfterSnapshot  Int     @default(0)
  unitPriceSnapshot    Decimal
  quantity             Int     @default(1)

  sortOrder Int?

  createdAt DateTime @default(now())

  staffBookings StaffBooking[]

  @@unique([appointmentId, sortOrder])
  @@index([appointmentId])
  @@index([status])
  @@index([staffId])
  @@index([serviceId])
  @@index([comboId])
}

model StaffBooking {
  id String @id @default(uuid())

  shopId  String
  staffId String

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  appointmentItemId String?
  appointmentItem   AppointmentItem? @relation(fields: [appointmentItemId], references: [id], onDelete: Cascade)

  startTime DateTime @db.Timestamptz(3)
  endTime   DateTime @db.Timestamptz(3)

  isActive Boolean @default(true)

  staff User @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shop  Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([shopId, staffId, startTime])
  @@index([shopId, staffId, isActive])
  @@index([appointmentId])
  @@index([appointmentItemId])
  @@index([staffId, startTime, endTime])
}

model Payment {
  id            String @id @default(uuid())
  appointmentId String @unique

  method String?
  amount Decimal

  status PaymentStatus
  paidAt DateTime?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model Review {
  id            String @id @default(uuid())
  appointmentId String @unique

  rating  Int
  comment String?

  createdAt DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model Conversation {
  id String @id @default(uuid())

  customerId    String
  staffId       String?
  appointmentId String? @unique

  status ConversationStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    User         @relation("CustomerConversations", fields: [customerId], references: [id])
  staff       User?        @relation("StaffConversations", fields: [staffId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  messages Message[]
}

model Message {
  id String @id @default(uuid())

  conversationId String

  senderType SenderType
  senderId   String?

  content String

  messageType MessageType @default(TEXT)

  telegramMsgId BigInt?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model TelegramAccount {
  staffId        String  @id
  telegramUserId BigInt  @unique
  username       String?

  staff User @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Notification {
  id String @id @default(uuid())

  userId String

  type NotificationType

  title   String
  content String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model WorkingHour {
  id String @id @default(uuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  dayOfWeek DayOfWeek

  openTime  DateTime @db.Time(0)
  closeTime DateTime @db.Time(0)

  isClosed Boolean @default(false)

  @@index([shopId, dayOfWeek])
}

model StaffSchedule {
  id String @id @default(uuid())

  staffId   String
  shopId    String
  dayOfWeek DayOfWeek

  startTime DateTime @db.Time(0)
  endTime   DateTime @db.Time(0)

  isActive Boolean @default(true)

  staff User @relation(fields: [staffId], references: [id], onDelete: Cascade)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, staffId, dayOfWeek, startTime, endTime])
  @@index([shopId, staffId, dayOfWeek])
}

model StaffDayOff {
  id String @id @default(uuid())

  staffId String
  shopId  String
  date    DateTime @db.Date

  reason String?

  staff User @relation(fields: [staffId], references: [id], onDelete: Cascade)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, staffId, date])
}

model Material {
  id String @id @default(uuid())

  name        String
  description String?

  unit MaterialUnit

  costPrice Decimal

  stockQuantity Float?

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  serviceMaterials ServiceMaterial[]
}

model ServiceMaterial {
  id String @id @default(uuid())

  serviceId  String
  materialId String

  quantity Float

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([serviceId, materialId])
}
